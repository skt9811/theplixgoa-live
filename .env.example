# Copy to .env and fill in real values. .env is gitignored; this file is not
# and must never contain a real secret.

# Hostinger SMTP for scripts/outreach/ (backlink outreach pipeline)
OUTREACH_SMTP_HOST=smtp.hostinger.com
OUTREACH_SMTP_PORT=465
OUTREACH_SMTP_SECURE=true
OUTREACH_SMTP_USER=partnerships@theplixgoa.com
OUTREACH_SMTP_PASS=your_email_password_here
OUTREACH_FROM_NAME="The Plix Goa Partnerships"

# Dedicated PMS database (expenses, vouchers, invoices). Separate Neon project
# from DATABASE_URL so PMS data never lands in the website database.
NEON_PMS_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
