# Copy to .env and fill in real values. .env is gitignored; this file is not
# and must never contain a real secret.

# Hostinger SMTP for scripts/outreach/ (backlink outreach pipeline)
OUTREACH_SMTP_HOST=smtp.hostinger.com
OUTREACH_SMTP_PORT=465
OUTREACH_SMTP_SECURE=true
OUTREACH_SMTP_USER=partnerships@theplixgoa.com
OUTREACH_SMTP_PASS=your_email_password_here
OUTREACH_FROM_NAME="The Plix Goa Partnerships"

# Dedicated PMS database (expenses, vouchers, invoices), separate from DATABASE_URL.
NEON_PMS_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: password for /pms. Falls back to ADMIN_PIN when unset.
PMS_ADMIN_PASSWORD=your_pms_password_here

# Firebase Admin SDK service account (push notifications). PRIVATE_KEY must
# stay a single line with literal \n sequences, not real newlines.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
# Client-side (Vite, inlined at BUILD time — must be set wherever the Plix
# Partner app's web bundle is actually built, e.g. Vercel's dashboard, not
# just here). Gates @capacitor/push-notifications' register() call, which
# crashes the native Activity if android/app/google-services.json is
# missing — only set this once that file is genuinely in place.
VITE_FCM_CONFIGURED=true

# Shared secret Make.com sends as the x-webhook-secret header when POSTing
# forwarded Airbnb notification emails to /api/webhooks/airbnb-inquiry. No
# code fallback exists for this on purpose — set the same generated value
# here (local), in Vercel's dashboard (production), and in Make.com's HTTP
# module's header config.
AIRBNB_WEBHOOK_SECRET=your_generated_webhook_secret_here
