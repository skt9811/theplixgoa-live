# Copy to keystore.properties (gitignored) and fill in. Never commit the real file or the .jks.
# Create the Plix guest-app upload key once with:
#   keytool -genkeypair -v -keystore theplix-app-upload.jks -alias theplix-app-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=../theplix-app-upload.jks
storePassword=CHANGE_ME
keyAlias=theplix-app-upload
keyPassword=CHANGE_ME
