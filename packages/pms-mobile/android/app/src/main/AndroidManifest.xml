<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google sign-in deep-link return (pms-google-button.tsx /
                 pms_.auth.callback.tsx / __root.tsx's appUrlOpen listener):
                 Google OAuth is run in an external Custom Tab, never this
                 app's own WebView (Google rejects it there outright), so
                 the Custom Tab hands the finished session back to this
                 specific app via this scheme instead of a theplixgoa.com
                 URL, which would just stay open in the tab. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.plix.pms" android:host="oauth-callback" />
            </intent-filter>

        </activity>

        <!-- exported="true": a pinned Home Screen shortcut (AirbnbHostPlugin's
             pinShortcut, requestPinShortcut) is invoked by the OS launcher —
             a separate app/process — which can only start an explicit-
             component Activity Intent if it's exported; routing through
             MainActivity instead would flash the PMS web dashboard loading
             before handing off, defeating the shortcut's "straight into the
             Space" point, since this app has no bundled webDir (see
             MainActivity's own onCreate comment). Opening this surface up
             externally means EXTRA_URL is no longer a value this app's own
             JS always controls, so onCreate below only loads it if its host
             is airbnb.com — anything else falls back to DEFAULT_URL instead
             of letting another app point this WebView at an arbitrary page. -->
        <activity
            android:name=".AirbnbHostActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <!-- Secondary resolution path for a pinned shortcut's Intent,
                 alongside the explicit-component Intent AirbnbHostPlugin
                 builds. Some OEM launchers (Samsung/Xiaomi/OnePlus-Realme,
                 the ones reported failing "isRequestPinShortcutSupported")
                 re-resolve or re-persist a pinned shortcut's Intent through
                 action/category/data matching rather than keeping the
                 explicit ComponentName + extras intact, especially across a
                 reboot — without a matching intent-filter here, that
                 re-resolution has nothing to find and the shortcut silently
                 stops working (or the pin request itself gets rejected
                 up front). onCreate() below reads id/name/url from this
                 URI's query string as a fallback when the Intent arrives
                 this way instead of via extras. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="plixpms" android:host="space" />
            </intent-filter>
        </activity>

        <!-- Internal-only (exported="false") — fired by the PendingIntent
             AirbnbHostPlugin.pinShortcut passes to requestPinShortcut, so
             the app can show its own confirmation once the user actually
             accepts the OS's pin-shortcut prompt (requestPinShortcut's own
             return value only means the request was successfully issued,
             not that the user said yes). -->
        <receiver
            android:name=".ShortcutPinnedReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Legacy (pre-Android 8.0 / API <26) pinned-shortcut path: on those
         versions ShortcutManagerCompat.requestPinShortcut falls back to
         broadcasting ACTION_INSTALL_SHORTCUT for the launcher to pick up,
         which historically required the requesting app to hold this
         permission — minSdkVersion here is 24, so this path is reachable on
         real devices, not just a formality. Harmless on newer versions,
         which use the real ShortcutManager API and ignore this permission
         entirely. -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!--
      Classic Bluetooth (RFCOMM/SPP) for the POS receipt printer (see
      PosPrinterPlugin.java). Pre-Android 12 uses BLUETOOTH/BLUETOOTH_ADMIN
      plus location (the platform ties classic-BT device access to location
      permission on those versions); Android 12+ uses the scoped
      BLUETOOTH_CONNECT/BLUETOOTH_SCAN permissions instead. The app only
      ever connects to an already-paired MAC address typed into Printer
      settings — it never calls startDiscovery() to scan for nearby
      devices — but BLUETOOTH_SCAN is still requested at runtime because
      AdapterService.cancelDiscovery() (a courtesy call made before every
      connect, in case a scan happens to be running) itself enforces that
      permission on API 31+; usesPermissionFlags="neverForLocation" means
      it does not also require ACCESS_FINE_LOCATION on those versions.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
</manifest>
