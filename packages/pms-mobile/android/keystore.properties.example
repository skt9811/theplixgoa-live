# Copy to keystore.properties (gitignored) and fill in. Never commit the real file or the .jks.
# Create the Plix PMS upload key once with:
#   keytool -genkeypair -v -keystore plix-pms-upload.jks -alias plix-pms-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=../plix-pms-upload.jks
storePassword=CHANGE_ME
keyAlias=plix-pms-upload
keyPassword=CHANGE_ME
