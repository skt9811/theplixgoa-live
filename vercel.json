{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/properties/chico-estate",
      "destination": "/properties/vivenda-chico",
      "permanent": true
    },
    { "source": "/casa-marina", "destination": "/properties/casa-marina", "permanent": true },
    { "source": "/casa-marina/", "destination": "/properties/casa-marina", "permanent": true },
    { "source": "/casa-moana", "destination": "/properties/casa-moana", "permanent": true },
    { "source": "/casa-moana/", "destination": "/properties/casa-moana", "permanent": true },
    { "source": "/casa-meadows", "destination": "/properties/casa-meadows", "permanent": true },
    { "source": "/casa-meadows/", "destination": "/properties/casa-meadows", "permanent": true },
    { "source": "/harbor-court", "destination": "/properties/harbor-court", "permanent": true },
    { "source": "/harbor-court/", "destination": "/properties/harbor-court", "permanent": true },
    { "source": "/the-plix-villa", "destination": "/properties/the-plix-villa", "permanent": true },
    { "source": "/the-plix-villa/", "destination": "/properties/the-plix-villa", "permanent": true },
    { "source": "/morjim-pride", "destination": "/properties/morjim-pride", "permanent": true },
    { "source": "/morjim-pride/", "destination": "/properties/morjim-pride", "permanent": true },
    { "source": "/vivenda-chico", "destination": "/properties/vivenda-chico", "permanent": true },
    { "source": "/vivenda-chico/", "destination": "/properties/vivenda-chico", "permanent": true },
    { "source": "/the-plix-resort-morjim", "destination": "/properties/the-plix-resort-morjim", "permanent": true },
    { "source": "/the-plix-resort-morjim/", "destination": "/properties/the-plix-resort-morjim", "permanent": true },
    { "source": "/villa-madera", "destination": "/properties/villa-madera", "permanent": true },
    { "source": "/villa-madera/", "destination": "/properties/villa-madera", "permanent": true },
    { "source": "/casa-serenita", "destination": "/properties/casa-serenita", "permanent": true },
    { "source": "/casa-serenita/", "destination": "/properties/casa-serenita", "permanent": true },
    { "source": "/plix-villa", "destination": "/properties/the-plix-villa", "permanent": true },
    { "source": "/plix-villa/", "destination": "/properties/the-plix-villa", "permanent": true },
    { "source": "/plix-resort", "destination": "/properties/the-plix-resort-morjim", "permanent": true },
    { "source": "/plix-resort/", "destination": "/properties/the-plix-resort-morjim", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/contact-us/", "destination": "/contact", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/about-us/", "destination": "/about", "permanent": true },
    { "source": "/photo-gallery-i", "destination": "/stays", "permanent": true },
    { "source": "/photo-gallery-i/", "destination": "/stays", "permanent": true },
    { "source": "/photo-gallery-ii", "destination": "/stays", "permanent": true },
    { "source": "/photo-gallery-ii/", "destination": "/stays", "permanent": true },
    { "source": "/category/:path*", "destination": "/blog", "permanent": true },
    { "source": "/tag/:path*", "destination": "/blog", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/dotgrip",
      "destination": "https://dotgrip-website.vercel.app/dotgrip"
    },
    {
      "source": "/dotgrip/:path*",
      "destination": "https://dotgrip-website.vercel.app/dotgrip/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
